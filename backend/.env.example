PORT=4000
FRONTEND_URL=http://localhost:5173

# Aiven MySQL connection values
# Easiest option: paste Aiven's Service URI here.
DATABASE_URL=mysql://avnadmin:your-aiven-password@your-aiven-host.aivencloud.com:12345/defaultdb

# Or use separate fields instead.
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Gmail SMTP for password-reset emails. Create a Google App Password; do not use
# the normal Gmail password and never commit the real SMTP_PASS value.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=scoutssystem@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="SCOUT OS <scoutssystem@gmail.com>"

# Cloudinary image storage for the shared ScoutOS Gallery.
# Keep these server-side only; do not expose the API secret to Vite/frontend env.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_GALLERY_FOLDER=scoutos/gallery
