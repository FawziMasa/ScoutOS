PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:4000

# Use long, random, different values in production. JWT_SECRET keeps sessions
# valid across Render restarts; the rate-limit secret keeps request hashes stable.
JWT_SECRET=replace-with-a-long-random-secret
PASSWORD_RESET_RATE_LIMIT_SECRET=replace-with-another-long-random-secret
# Optional separate secret for one-hour Gallery media links. JWT_SECRET is used
# when this is not set.
GALLERY_MEDIA_SECRET=replace-with-a-third-long-random-secret

# Aiven MySQL connection values
# Easiest option: paste Aiven's Service URI here.
DATABASE_URL=mysql://avnadmin:your-aiven-password@your-aiven-host.aivencloud.com:12345/defaultdb

# Or use separate fields instead.
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Brevo SMTP for password-reset and account-invitation emails. Generate an SMTP key (not an API key),
# verify EMAIL_FROM as a Brevo sender, and never commit the real SMTP_PASS value.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_FAMILY=4
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM="SCOUT OS <verified-sender@example.com>"

# Optional Cloudinary image storage for the shared ScoutOS Gallery.
# If these are left blank, ScoutOS stores Gallery image bytes in MySQL instead.
# Keep CLOUDINARY_API_SECRET server-side only; do not expose it to Vite/frontend env.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_GALLERY_FOLDER=scoutos/gallery
